# Google Gemini — recommended for Tourez AI Trip Planner & Chat
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Alternative provider, optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: set to false to use live AI strictly without demo fallbacks
USE_MOCK=false

# CORS origins for the frontend (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
